{
  "permissions": {
    "allow": [
      "Bash(buzz)",
      "Bash(buzz *)",
      "Bash(buzz:*)",
      "PowerShell(buzz)",
      "PowerShell(buzz *)",
      "PowerShell(buzz:*)",

      "Read",
      "Glob",
      "Grep",
      "WebFetch(domain:kaptswk.communities.buzz.xyz)",

      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",

      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm install)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  }
}
